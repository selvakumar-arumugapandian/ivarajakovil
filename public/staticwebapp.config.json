{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/books/*",
      "/videos/*",
      "/robots.txt",
      "/sitemap.xml",
      "/*.{css,js,ico,png,jpg,jpeg,webp,svg,woff,woff2,pdf,txt,xml}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  },
  "mimeTypes": {
    ".pdf": "application/pdf"
  }
}
